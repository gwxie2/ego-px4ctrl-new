Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /uav01
        - /uav01/Map Inflate uav01
        - /uav11
        - /uav11/Map Inflate uav11
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Depth uav0
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /uav0/ego_planner_node/optimal_list
          Name: Optimal Traj uav0
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Map Inflate uav0
          Enabled: true
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.1
          Style: Boxes
          Topic: /uav0/ego_planner_node/grid_map/occupancy_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Image
          Enabled: true
          Image Topic: /iris_0/realsense/depth_camera/depth/image_raw
          Max Value: 8
          Median window: 5
          Min Value: 0
          Name: Depth uav0
          Normalize Range: false
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
      Enabled: true
      Name: uav0
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /uav1/ego_planner_node/optimal_list
          Name: Optimal Traj uav1
          Namespaces:
            "": true
          Queue Size: 100
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Map Inflate uav1
          Enabled: true
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.1
          Style: Boxes
          Topic: /uav1/ego_planner_node/grid_map/occupancy_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Image
          Enabled: true
          Image Topic: /iris_1/realsense/depth_camera/depth/image_raw
          Max Value: 8
          Median window: 5
          Min Value: 0
          Name: Depth uav1
          Normalize Range: false
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
      Enabled: true
      Name: uav1
    - Alpha: 1
      Axes Length: 0.8
      Axes Radius: 0.08
      Class: rviz/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: Pose uav0
      Shaft Length: 0.7
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /iris_0/bridge_pose
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 0.8
      Axes Radius: 0.08
      Class: rviz/Pose
      Color: 25; 255; 0
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: Pose uav1
      Shaft Length: 0.7
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /iris_1/bridge_pose
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 1.1
      Axes Radius: 0.1
      Class: rviz/Pose
      Color: 255; 255; 0
      Enabled: true
      Name: Goal uav0
      Shape: Axes
      Topic: /uav0/goal
      Unreliable: false
      Value: true
    - Alpha: 1
      Axes Length: 1.1
      Axes Radius: 0.1
      Class: rviz/Pose
      Color: 0; 255; 255
      Enabled: true
      Name: Goal uav1
      Shape: Axes
      Topic: /uav1/goal
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617994
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.5
        Y: 1.5
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 2.7
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 60
  Y: 40

  Depth uav0:
    collapsed: false
  Depth uav1:
    collapsed: false