<launch>
<!-- ============================================================= -->
<!-- Auto-generated by swarm_launch_generator.py          -->
<!-- Number of UAVs: 2                                    -->
<!-- Config file: /tmp/tmp.kc2kWMjmeG/test_dual.md                          -->
<!-- ============================================================= -->

  <!-- ========================================== -->
  <!-- Global Arguments                            -->
  <!-- ========================================== -->
  
  <arg name="world" default="$(find px4)/Tools/sitl_gazebo/worlds/swarm_benchmark_forest_phase2.world"/>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="debug" default="false"/>
  
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="$(find clean_uav_core)/rviz/swarm_rviz.rviz"/>
  
  <arg name="enable_vins" default="false"/>
  
  <!-- ===== 规划器参数 ===== -->
  <arg name="planner_max_vel" default="1.2"/>
  <arg name="planner_max_acc" default="2.8"/>
  <arg name="planner_max_jerk" default="4.0"/>
  <arg name="planner_fail_safe" default="true"/>
  <arg name="planner_flight_type" default="1"/>
  <arg name="planner_realworld_experiment" default="false"/>
  
  <!-- ===== Grid Map 参数 ===== -->
  <arg name="map_size_x" default="80.0"/>
  <arg name="map_size_y" default="80.0"/>
  <arg name="map_size_z" default="5.0"/>
  <arg name="grid_map_ground_height" default="-0.01"/>
  <arg name="grid_map_odom_depth_timeout" default="2.0"/>
  <arg name="grid_map_depth_filter_mindist" default="0.1"/>
  <arg name="grid_map_obstacles_inflation" default="0.45"/>
  
  <!-- ===== 飞控器参数（核心调试参数） ===== -->
  <arg name="hover_percent" default="0.58"/>
  <arg name="mass" default="1.2"/>
  
  <!-- ===== 触发器时序 ===== -->
  <arg name="takeoff_delay" default="8.0"/>
  <arg name="traj_trigger_delay" default="20.0"/>
  <arg name="traj_trigger_repeat" default="3"/>
  <arg name="traj_trigger_rate" default="3.0"/>
  
  <!-- ===== 动态目标参数 ===== -->
  <arg name="goal_start_delay" default="$(eval float(arg('takeoff_delay')) + 12.0)"/>
  <arg name="goal_publish_rate" default="5.0"/>
  <arg name="goal_period_sec" default="30.0"/>
  <arg name="enable_oscillation" default="true"/>
  
  <!-- ========================================== -->
  <!-- Gazebo Simulation                             -->
  <!-- ========================================== -->
  
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- UAV Instances (drone_X namespace)             -->
  <!-- ========================================== -->
  
  <!-- drone_0 -->
  <include file="$(find clean_uav_core)/launch/swarm_uav_instance.launch">
    <arg name="drone_id" value="0"/>
    <arg name="init_x" value="0.0"/>
    <arg name="init_y" value="2.0"/>
    <arg name="init_z" value="0.1"/>
    <arg name="init_yaw" value="0.0"/>
    <arg name="target_x" value="8.0"/>
    <arg name="target_y" value="2.0"/>
    <arg name="target_z" value="1.0"/>
    <arg name="enable_vins" value="$(arg enable_vins)"/>
    <arg name="planner_max_vel" value="$(arg planner_max_vel)"/>
    <arg name="planner_max_acc" value="$(arg planner_max_acc)"/>
    <arg name="planner_max_jerk" value="$(arg planner_max_jerk)"/>
    <arg name="planner_fail_safe" value="$(arg planner_fail_safe)"/>
    <arg name="planner_flight_type" value="$(arg planner_flight_type)"/>
    <arg name="planner_realworld_experiment" value="$(arg planner_realworld_experiment)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="grid_map_ground_height" value="$(arg grid_map_ground_height)"/>
    <arg name="grid_map_odom_depth_timeout" value="$(arg grid_map_odom_depth_timeout)"/>
    <arg name="grid_map_depth_filter_mindist" value="$(arg grid_map_depth_filter_mindist)"/>
    <arg name="grid_map_obstacles_inflation" value="$(arg grid_map_obstacles_inflation)"/>
    <arg name="hover_percent" value="$(arg hover_percent)"/>
    <arg name="mass" value="$(arg mass)"/>
    <arg name="takeoff_delay" value="$(arg takeoff_delay)"/>
  </include>
  
  <!-- drone_1 -->
  <include file="$(find clean_uav_core)/launch/swarm_uav_instance.launch">
    <arg name="drone_id" value="1"/>
    <arg name="init_x" value="0.0"/>
    <arg name="init_y" value="-2.0"/>
    <arg name="init_z" value="0.1"/>
    <arg name="init_yaw" value="0.0"/>
    <arg name="target_x" value="8.0"/>
    <arg name="target_y" value="-2.0"/>
    <arg name="target_z" value="1.0"/>
    <arg name="enable_vins" value="$(arg enable_vins)"/>
    <arg name="planner_max_vel" value="$(arg planner_max_vel)"/>
    <arg name="planner_max_acc" value="$(arg planner_max_acc)"/>
    <arg name="planner_max_jerk" value="$(arg planner_max_jerk)"/>
    <arg name="planner_fail_safe" value="$(arg planner_fail_safe)"/>
    <arg name="planner_flight_type" value="$(arg planner_flight_type)"/>
    <arg name="planner_realworld_experiment" value="$(arg planner_realworld_experiment)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="grid_map_ground_height" value="$(arg grid_map_ground_height)"/>
    <arg name="grid_map_odom_depth_timeout" value="$(arg grid_map_odom_depth_timeout)"/>
    <arg name="grid_map_depth_filter_mindist" value="$(arg grid_map_depth_filter_mindist)"/>
    <arg name="grid_map_obstacles_inflation" value="$(arg grid_map_obstacles_inflation)"/>
    <arg name="hover_percent" value="$(arg hover_percent)"/>
    <arg name="mass" value="$(arg mass)"/>
    <arg name="takeoff_delay" value="$(arg takeoff_delay)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- Synchronized Trajectory Trigger               -->
  <!-- ========================================== -->
  
  <node pkg="clean_uav_core" type="swarm_traj_trigger.py" name="swarm_traj_trigger" output="screen">
    <param name="num_uavs" value="2"/>
    <param name="delay" value="$(arg traj_trigger_delay)"/>
    <param name="repeat" value="$(arg traj_trigger_repeat)"/>
    <param name="rate" value="$(arg traj_trigger_rate)"/>
    <param name="frame_id" value="world"/>
  </node>
  
  <!-- ========================================== -->
  <!-- Dynamic Goal Commander                        -->
  <!-- ========================================== -->
  
  <node pkg="clean_uav_core" type="swarm_dynamic_commander.py" name="swarm_dynamic_commander" output="screen">
    <param name="config_file" value="/tmp/tmp.kc2kWMjmeG/test_dual.md"/>
    <param name="frame_id" value="world"/>
    <param name="start_delay" value="$(arg goal_start_delay)"/>
    <param name="publish_rate" value="$(arg goal_publish_rate)"/>
    <param name="enable_oscillation" value="$(arg enable_oscillation)"/>
    <param name="period_sec" value="$(arg goal_period_sec)"/>
  </node>
  
  <!-- ========================================== -->
  <!-- RViz Visualization                            -->
  <!-- ========================================== -->
  
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="swarm_rviz" args="-d $(arg rviz_config)" output="screen"/>
  
</launch>