    <arg name="planner_fail_safe" value="$(arg planner_fail_safe)"/>
    <arg name="planner_flight_type" value="$(arg planner_flight_type)"/>
    <arg name="planner_realworld_experiment" value="$(arg planner_realworld_experiment)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="grid_map_ground_height" value="$(arg grid_map_ground_height)"/>
    <arg name="grid_map_odom_depth_timeout" value="$(arg grid_map_odom_depth_timeout)"/>
    <arg name="grid_map_depth_filter_mindist" value="$(arg grid_map_depth_filter_mindist)"/>
    <arg name="grid_map_obstacles_inflation" value="$(arg grid_map_obstacles_inflation)"/>
    <arg name="hover_percent" value="$(arg hover_percent)"/>
    <arg name="mass" value="$(arg mass)"/>
    <arg name="takeoff_delay" value="$(arg takeoff_delay)"/>
    <arg name="planner_start_z_threshold" value="$(arg planner_start_z_threshold)"/>
    <arg name="planner_start_stable_duration" value="$(arg planner_start_stable_duration)"/>
    <arg name="planner_start_timeout" value="$(arg planner_start_timeout)"/>
    <arg name="planner_post_takeoff_delay" value="$(arg planner_post_takeoff_delay)"/>
    <arg name="swarm_acceptance_radius" value="$(arg swarm_acceptance_radius)"/>
    <arg name="swarm_filter_far_trajectories" value="$(arg swarm_filter_far_trajectories)"/>
    <arg name="swarm_time_warn_threshold" value="$(arg swarm_time_warn_threshold)"/>
    <arg name="swarm_time_reject_threshold" value="$(arg swarm_time_reject_threshold)"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="swarm_weight" value="$(arg swarm_weight)"/>
    <arg name="swarm_symmetry_gain" value="$(arg swarm_symmetry_gain)"/>
    <arg name="planner_goal_topic" value="$(arg planner_goal_topic)"/>
    <arg name="planning_broadcast_topic" value="$(arg planning_broadcast_topic_v2)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- Dynamic Goal Commander                        -->
  <!-- ========================================== -->
  
  <node pkg="clean_uav_core" type="swarm_dynamic_commander_v2.py" name="swarm_dynamic_commander_v2" output="screen">
    <param name="config_file" value="/home/guanwen/XTDrone/ego-px4ctrl-new/docs/uav_position_goal.md"/>
    <param name="start_delay" value="$(arg goal_start_delay)"/>
    <param name="publish_rate" value="$(arg goal_publish_rate)"/>
    <param name="enable_oscillation" value="$(arg enable_oscillation)"/>
    <param name="period_sec" value="$(arg goal_period_sec)"/>
    <param name="goal_topic" value="$(arg planner_goal_topic)"/>
  </node>
  
  <!-- ========================================== -->
  <!-- Benchmark Suite                             -->
  <!-- ========================================== -->
  
  <group if="$(arg benchmark_enable)" ns="benchmark">
    <node pkg="clean_uav_core" type="benchmark_manager.py" name="benchmark_manager" output="screen">
      <param name="planner_node_name" value="ego_planner_v2"/>
      <param name="drone_count" value="6"/>
      <param name="output_dir" value="$(arg benchmark_output_dir)"/>
      <param name="record_rosbag" value="$(arg benchmark_record_rosbag)"/>
      <param name="low_speed_threshold" value="$(arg benchmark_low_speed_threshold)"/>
      <param name="low_speed_duration" value="$(arg benchmark_low_speed_duration)"/>
      <param name="goal_distance_threshold" value="$(arg benchmark_goal_distance_threshold)"/>
      <param name="stop_after_terminal_sec" value="$(arg benchmark_stop_after_terminal_sec)"/>
      <param name="safety_margin_threshold" value="$(arg benchmark_safety_margin_threshold)"/>
      <param name="actuator_saturation_threshold" value="$(arg benchmark_actuator_saturation_threshold)"/>
      <param name="default_vmax" value="$(arg benchmark_default_vmax)"/>
      <param name="default_drone_ids" value="0,1,2,3,4,5"/>
      <param name="default_goal_xs" value="-3.882285676537811,-10.606601717798213,-14.488887394336025,-14.488887394336025,-10.606601717798213,-3.882285676537811"/>
      <param name="default_goal_ys" value="14.488887394336025,10.606601717798211,3.882285676537811,-3.882285676537811,-10.606601717798211,-14.488887394336025"/>
      <param name="default_goal_zs" value="1.5,1.5,1.5,1.5,1.5,1.5"/>
      <param name="odom_topic_template" value="/drone_%d/odom"/>
      <param name="position_cmd_topic_template" value="/drone_%d/position_cmd"/>
      <param name="replan_info_topic_template" value="/drone_%d/ego_planner_v2/planning/replan_info"/>
      <param name="planner_event_topic_template" value="/drone_%d/ego_planner_v2/planning/benchmark_event"/>
      <param name="safety_topic_template" value="/drone_%d/ego_planner_v2/grid_map/occupancy_inflate"/>
      <param name="attitude_topic_template" value="/iris_%d/mavros/setpoint_raw/attitude"/>
      <param name="mavros_state_topic_template" value="/iris_%d/mavros/state"/>
      <param name="extrinsic_topic_template" value="/drone_%d/vins_estimator/extrinsic"/>
      <param name="px4_debug_topic_template" value="/drone_%d/px4ctrl/debugPx4ctrl"/>
    </node>
  </group>
  
  <!-- ========================================== -->
  <!-- Optional V2 Goal Tooling                     -->
  <!-- ========================================== -->
  
  <include if="$(arg enable_goal_tooling_v2)" file="$(find clean_uav_core)/launch/swarm_goal_tooling_v2.launch">
    <arg name="rviz_node_name" value="swarm_rviz"/>
    <arg name="enable_assign_goals" value="$(arg enable_assign_goals_v2)"/>
    <arg name="enable_random_goals" value="$(arg enable_random_goals_v2)"/>
    <arg name="selected_drones_topic" value="$(arg v2_selected_drones_topic)"/>
    <arg name="pose_goal_topic" value="$(arg v2_pose_goal_topic)"/>
    <arg name="goalset_topic" value="$(arg planner_goal_topic)"/>
    <arg name="arrow_topic" value="$(arg v2_goal_arrow_topic)"/>
    <arg name="drone_num" value="6"/>
  </include>
  
  <!-- ========================================== -->
  <!-- Optional V2 Moving Obstacles                -->
  <!-- ========================================== -->
  
  <include if="$(arg enable_moving_obstacles_v2)" file="$(find clean_uav_core)/launch/swarm_moving_obstacles_v2.launch">
    <arg name="enable_joy_node" value="$(arg enable_moving_obstacles_joy_node_v2)"/>
    <arg name="joy_topic" value="$(arg moving_obstacles_joy_topic_v2)"/>
    <arg name="broadcast_traj_topic" value="$(arg planning_broadcast_topic_v2)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- Optional V2 Manual Take Over                -->
  <!-- ========================================== -->
  
  <include if="$(arg enable_manual_take_over_station_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_station_v2.launch">
    <arg name="enable_joy_node" value="$(arg enable_manual_take_over_joy_node_v2)"/>
    <arg name="joy_input_topic" value="$(arg manual_take_over_joy_input_topic_v2)"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
    <arg name="joy_dev" value="$(arg manual_take_over_joy_dev_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="0"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="1"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="2"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="3"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="4"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <include if="$(arg enable_manual_take_over_v2)" file="$(find clean_uav_core)/launch/swarm_manual_take_over_instance_v2.launch">
    <arg name="drone_id" value="5"/>
    <arg name="joystick_topic" value="$(arg manual_take_over_joy_topic_v2)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- Optional V2 Odom Visualization              -->
  <!-- ========================================== -->
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="0"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="1"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="2"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="3"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="4"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <include if="$(arg enable_odom_visualization_v2)" file="$(find clean_uav_core)/launch/swarm_odom_visualization_instance_v2.launch">
    <arg name="drone_id" value="5"/>
    <arg name="robot_scale" value="$(arg odom_visualization_scale_v2)"/>
  </include>
  
  <!-- ========================================== -->
  <!-- RViz Visualization                            -->
  <!-- ========================================== -->
  
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="swarm_rviz" args="-d $(arg rviz_config)" output="screen"/>
  
</launch>