<launch>
  <arg name="start_vins_estimator" default="true"/>
  <arg name="start_vins_bridge" default="true"/>
  <arg name="odom_mode" default="vins_only"/>
  <arg name="vehicle_type" default="drone"/>
  <arg name="vehicle_num" default="2"/>
  <arg name="world_frame" default="world"/>
  <arg name="primary_odom_topic_suffix" default="vins_estimator/imu_propagate"/>
  <arg name="enable_fallback_local_odom" default="$(eval arg('odom_mode') == 'vins_with_fallback')"/>
  <arg name="primary_timeout_sec" default="0.6"/>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 1)" ns="drone_0">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_0_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 2)" ns="drone_1">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_1_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 3)" ns="drone_2">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_2_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 4)" ns="drone_3">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_3_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 5)" ns="drone_4">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_4_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 6)" ns="drone_5">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_5_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 7)" ns="drone_6">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_6_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 8)" ns="drone_7">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_7_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 9)" ns="drone_8">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_8_px4_sitl_config.yaml"/>
  </group>

  <group if="$(eval arg('start_vins_estimator') == 'true' and int(arg('vehicle_num')) >= 10)" ns="drone_9">
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(find vins)/../config/xtdrone_sitl/iris_9_px4_sitl_config.yaml"/>
  </group>

  <node if="$(arg start_vins_bridge)" pkg="clean_uav_core" type="multi_vins_bridge.py" name="swarm_multi_vins_bridge" output="screen">
    <param name="vehicle_type" value="$(arg vehicle_type)"/>
    <param name="vehicle_num" value="$(arg vehicle_num)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="odom_mode" value="$(arg odom_mode)"/>
    <param name="primary_odom_topic_suffix" value="$(arg primary_odom_topic_suffix)"/>
    <param name="enable_mavros_vision_pose" value="true"/>
    <param name="force_world_frame" value="true"/>
    <param name="enable_fallback_local_odom" value="$(arg enable_fallback_local_odom)"/>
    <param name="primary_timeout_sec" value="$(arg primary_timeout_sec)"/>
  </node>
</launch>
